# bedrock-bot: cTrader trading-bot (sub-fase 12.9 D4)
#
# Erstatter scalp_edge-boten som retires i D6 etter ≥24t grønn demo-test.
# Bot leser signaler fra bedrock-server `/bot/signals` (bot.yaml signal_url
# inkluderer `/bot`-prefix etter D3) og plasserer ordre via cTrader Open
# API. Auth-credentials hentes fra ~/.bedrock/secrets.env (D2 introduserte
# refresh-token-flyt + auto-update av samme fil).
#
# Restart-policy:
#   on-failure med backoff, MEN aldri ved exit 78 (FATAL =
#   token-refresh-flyten har gitt opp; operatør må generere ny
#   refresh_token manuelt med scripts/get_token.py og restarte service)
#   eller exit 80 (>50 % av instrumentene mangler hos megler — konto/
#   symbol-konfig må fikses av operatør).
#   Exit 79 = reconnect-budsjett oppbrukt (6 forsøk på 600 s). Det er
#   typisk et nettverks-glipp, ikke auth (auth er 78) — SKAL restartes.
#   2026-09-05: 79 lå i prevent-lista, boten døde etter et 10-minutters
#   nettverksbrudd og ble liggende død i 9 dager uten trades/logging.
#   Auth-loop-risikoen fra scalp_edge dekkes av 78, ikke 79.
#
# Avhengighet:
#   bedrock-server.service (system-unit) må være oppe slik at
#   /bot/signals svarer før bot prøver å hente første signal. Som
#   user-unit kan vi ikke `Requires=` system-units; bot's egen
#   fetch-fail-eskalering (safety.py) håndterer midlertidig
#   server-bortfall, og operatør har ansvaret for at bedrock-server
#   er oppe før bot startes.
[Unit]
Description=Bedrock trading-bot: cTrader-grensesnitt + signal-konsument
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/pc/bedrock
EnvironmentFile=/home/pc/.bedrock/secrets.env
ExecStart=/home/pc/bedrock/.venv/bin/python -m bedrock.bot --demo
Restart=on-failure
RestartSec=10s
RestartPreventExitStatus=78 80
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
